{
  "name": "kinetic-workshop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "An agent-accessible 3D workshop with annotations, data plots and optional real physics.",
  "bin": {
    "kinetic": "./cli.js"
  },
  "scripts": {
    "start": "node server/http.js",
    "dev": "node --watch server/http.js",
    "cli": "node cli.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tests/browser.py",
    "test:mcp": "node tests/mcp-smoke.js",
    "build": "node scripts/build.js",
    "verify": "npm test && npm run build",
    "test:replay": "python tests/replay-browser.py",
    "test:scene": "python tests/scene-browser.py",
    "test:native": "python tests/native-browser.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.0",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@modelcontextprotocol/sdk": "1.18.2",
    "zod": "3.25.76"
  }
}
